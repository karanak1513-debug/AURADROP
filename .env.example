# ==============================================================
# VAULT-ZERO: EPHEMERAL DEAD-DROP PLATFORM ENVIRONMENT CONFIG
# Note: The platform works OUT-OF-THE-BOX with high-performance
# in-memory ephemeral compartments if external variables are empty.
# ==============================================================

# (Optional) Upstash Redis for distributed multi-instance deployment
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# (Optional) S3 / Cloudflare R2 for distributed object storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=auto
# AWS_S3_BUCKET=vault-zero-dead-drop
# AWS_ENDPOINT_URL_S3=https://your-account-id.r2.cloudflarestorage.com
